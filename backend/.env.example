# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed CORS Origins (comma separated - includes Vercel frontend and local development)
ALLOWED_ORIGINS=https://balaji-portfolio-kappa.vercel.app,http://localhost:5173,http://localhost:3000

# Recipient Email for Contact Submissions
CONTACT_RECEIVER_EMAIL=yagateelabalaji@gmail.com

# Gmail SMTP Email Configuration (Nodemailer)
# Configure these in Render Dashboard -> Environment Variables:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM="Balaji Portfolio" <your_email@gmail.com>
